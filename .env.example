# Copy to .env.local and fill in. Names only here — never commit real values.
# On Vercel: Project → Settings → Environment Variables, same names.

# OpenAI (server-only). Model ids are configuration, never hard-coded.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
# Optional: minimal | low | medium | high — lower makes the art director faster.
OPENAI_TEXT_REASONING_EFFORT=
# Optional: low | medium | high (default medium).
OPENAI_IMAGE_QUALITY=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=designs

# Kill switch for image generation: the chat and render routes answer 403
# unless this is exactly "true". Sign-in is required either way; set it to
# "false" to stop all OpenAI spend at once.
ALLOW_UNAUTHENTICATED_GENERATION=

# Public site URL, used for metadata, sitemap and llms.txt (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Free tier (D83): HMAC key for the quota keys. Long and random; never change it once live, or counts reset.
QUOTA_SECRET=
# Accounts with no free-tier limit (comma-separated emails).
QUOTA_EXEMPT_EMAILS=
# Accounts that can open /admin (comma-separated emails).
ADMIN_EMAILS=
